# Supabase credentials (get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Company policy
COMPANY_START_TIME="09:30"

# Custom Seeding Credentials
MANAGER_EMAIL="manager@worktrack.io"
MANAGER_PASSWORD="manager@123"
EMPLOYEE_PASSWORD="employee@123"
